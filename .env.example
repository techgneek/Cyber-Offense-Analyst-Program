# Lab-only Gemini key. Do not commit a real secret.
GEMINI_API_KEY=PlaceholderForYourGeminiApiKey

# Optional frontend/backend origin overrides for local or split-host lab use.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Model selection and runtime hardening.
TEXT_CHAT_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.0-flash-lite-001,gemini-2.0-flash
NODE_ENV=development
DISABLE_HMR=false

# SOC 2 / evidence controls.
SOC2_ENFORCEMENT_ENABLED=true
SOC2_ENFORCEMENT_STRICT=true
SHADOW_CONTAINMENT_ENABLED=true
SHADOW_TESTER_TOKEN=

# DoS guardrails.
DOS_RATE_LIMIT_RPM=60
DOS_MAX_PAYLOAD_CHARS=8000
DOS_MAX_HISTORY_TURNS=16

# Enable Training mode.
# LAB_TRAINING_MODE=true