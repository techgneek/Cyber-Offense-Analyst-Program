# Lab-specific deployment values. Copy this file to terraform.tfvars locally
# or supply a separate -var-file when running Terraform.

name_prefix = "cyber-offense-lab"
environment = "lab"
location    = "eastus"

# Replace with the image pushed by the lab deployment workflow.
container_image = "cyberoffenselabjd4des.azurecr.io/aetos-ai-security-mentor:lab-latest"

container_port  = 3000
container_cpu   = 0.25
container_memory = "0.5Gi"

min_replicas = 0
max_replicas = 1

public_ingress = true

environment_variables = {
  LAB_TRAINING_MODE = "true"
}

# Keep secret values local and unshared. Add only lab secrets here.
container_secrets = {
  # GEMINI_API_KEY = "replace-with-lab-only-secret"
}

tags = {
  project            = "cyber-offense-lab"
  environment        = "security-testing"
  owner              = "james"
  "managed-by"       = "terraform"
  "production-data"  = "prohibited"
  "auto-shutdown"    = "scale-to-zero"
}
